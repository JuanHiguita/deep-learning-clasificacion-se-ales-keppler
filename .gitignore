# datos y modelos grandes
data/*
!data/seleccion_demo.csv
!data/.gitkeep
*.npz
*.fits
*.fits.gz
modelos/**/*.keras
# resultados: se versionan métricas y tablas, no predicciones
resultados/**/*.npz
# entorno
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/
*.keras
__pycache__/
resultados/**/parciales/
resultados/dl/cordura/
resultados/dl/busqueda_demo/

# pesos que SÍ se versionan para poder volver a desplegar (son pequeños)
!modelos/**/*.keras
!modelos/**/*.npz
!resultados/dl/fusion/e6a_cuatro_ramas/cabezas/*.keras

# iteración 2: entorno y datos grandes fuera de git; selección, ejemplos y evidencias sí se versionan
.venv_gpu/
iteracion_2/datos/llc/
iteracion_2/datos/*.npz

# Iteración 2: los modelos de cada configuración de la búsqueda pesan cientos de MB; se versionan
# solo los elegidos (iteracion_2/modelos_finales) y las predicciones y métricas de todas.
iteracion_2/evidencias/resultados/busqueda/*/cfg*/modelos/
# Iteración 2: sí se versionan los modelos finales (codificadores elegidos y sus vectores) y la fusión.
!iteracion_2/modelos_finales/**/*.keras
!iteracion_2/modelos_finales/**/*.npz
!iteracion_2/evidencias/resultados/fusion/**/*.keras
!iteracion_2/evidencias/resultados/fusion/**/*.npz
!iteracion_2/evidencias/resultados/fusion_exploratoria_auc/**/*.npz
